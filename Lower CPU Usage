<#
.SYNOPSIS
    Smart CPU Throttle & Bloatware Suspension with Auto-Restoration.
.DESCRIPTION
    1. Identifies "Useless" services (Xbox, Maps, Telemetry) vs "Active" apps.
    2. Stops services ONLY if the associated app is NOT running.
    3. Throttles high-load background processes.
    4. Registers a temporary "Watchdog" task that reverts changes when CPU drops.
#>

# --- CONFIGURATION ---
$LogPath = "C:\ProgramData\NinjaRMMLogs\CpuSurgeState.xml"
$WatchdogName = "Ninja_CPU_Watchdog"

# Map Services to their "Parent" App (If App is running, keep Service alive)
# Format: @{ "ServiceName" = "ProcessName" }
# If ProcessName is "*", it means "Always Kill" (True Bloatware)
$BloatMap = @{
    "XblAuthManager"    = "XboxApp"
    "XblGameSave"       = "XboxApp"
    "XboxNetApiSvc"     = "XboxApp"
    "MapsBroker"        = "Maps"
    "DiagTrack"         = "*" # Connected User Experiences (Telemetry)
    "SysMain"           = "*" # Superfetch (High disk/CPU usage on some builds)
    "WSearch"           = "*" # Windows Search Indexer (Safe to pause)
    "RetailDemo"        = "*"
    "Fax"               = "*"
}

# --- PHASE 1: INTELLIGENT SUSPENSION ---

# Create specific log directory if missing
if (!(Test-Path "C:\ProgramData\NinjaRMMLogs")) { New-Item -ItemType Directory -Path "C:\ProgramData\NinjaRMMLogs" -Force | Out-Null }

# Export CURRENT state of these services before we touch them (For Undo)
Get-Service -Name $BloatMap.Keys -ErrorAction SilentlyContinue | Export-Clixml -Path $LogPath -Force

Write-Output " [INTEL] Service State backed up to $LogPath"

foreach ($Service in $BloatMap.Keys) {
    $ParentApp = $BloatMap[$Service]
    $SvcObj = Get-Service -Name $Service -ErrorAction SilentlyContinue

    # Skip if service doesn't exist or is already stopped
    if (!$SvcObj -or $SvcObj.Status -ne 'Running') { continue }

    # CHECK: Is the user actually using the app?
    $IsActive = $false
    if ($ParentApp -ne "*") {
        if (Get-Process -Name $ParentApp -ErrorAction SilentlyContinue) {
            $IsActive = $true
            Write-Output " [SKIP] $Service is needed by active app: $ParentApp"
        }
    }

    # ACTION: Stop and Disable (Temporary)
    if (!$IsActive) {
        Stop-Service -Name $Service -Force -ErrorAction SilentlyContinue
        Set-Service -Name $Service -StartupType Manual -ErrorAction SilentlyContinue
        Write-Output " [KILL] Suspended overhead service: $Service"
    }
}

# --- PHASE 2: PRIORITY THROTTLING (NON-DESTRUCTIVE) ---
$Gluttons = @("chrome", "msedge", "teams", "onedrive", "officeclicktorun")
foreach ($proc in $Gluttons) {
    Get-Process -Name $proc -ErrorAction SilentlyContinue | ForEach-Object {
        if ($_.PriorityClass -ne 'BelowNormal') {
            $_.PriorityClass = 'BelowNormal'
        }
    }
}
Write-Output " [TWEAK] Background apps set to 'Below Normal' priority."

# --- PHASE 3: THE WATCHDOG (AUTO-UNDO) ---
# Create a self-destructing scheduled task that checks CPU every 5 mins.
# If CPU < 25%, it restores services and deletes itself.

$WatchdogScript = @"
    `$AvgCPU = (Get-Counter '\Processor(_Total)\% Processor Time' -SampleInterval 2 -MaxSamples 5).CounterSamples.CookedValue | Measure-Object -Average | Select-Object -ExpandProperty Average
    if (`$AvgCPU -lt 25) {
        # RESTORE SERVICES
        if (Test-Path '$LogPath') {
            `$Services = Import-Clixml -Path '$LogPath'
            foreach (`$S in `$Services) {
                if (`$S.Status -eq 'Running') { 
                    Start-Service -Name `$S.Name -ErrorAction SilentlyContinue 
                    Set-Service -Name `$S.Name -StartupType `$S.StartType -ErrorAction SilentlyContinue
                }
            }
        }
        # UNREGISTER SELF
        Unregister-ScheduledTask -TaskName '$WatchdogName' -Confirm:`$false
    }
"@

# Encode script for Task Scheduler
$Bytes = [System.Text.Encoding]::Unicode.GetBytes($WatchdogScript)
$Encoded = [Convert]::ToBase64String($Bytes)
$Command = "powershell.exe -EncodedCommand $Encoded"

# Register the Watchdog (Runs every 10 mins indefinitely until it kills itself)
$Action = New-ScheduledTaskAction -Execute "powershell.exe" -Argument "-EncodedCommand $Encoded"
$Trigger = New-ScheduledTaskTrigger -Once -At (Get-Date) -RepetitionInterval (New-TimeSpan -Minutes 10)
$Principal = New-ScheduledTaskPrincipal -UserId "SYSTEM" -LogonType ServiceAccount -RunLevel Highest
Register-ScheduledTask -TaskName $WatchdogName -Action $Action -Trigger $Trigger -Principal $Principal -Force | Out-Null

Write-Output " [SECURE] Watchdog planted. System will auto-revert when CPU drops below 25%."
