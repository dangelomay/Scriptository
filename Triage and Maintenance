# ==============================================================================
# Elite MSP Autonomous Proactive Triage & Maintenance (NinjaOne v5)
# Includes OmniSync, VSS Purge, Telemetry Kill, Cache Reset, & Autonomous Patching
# ==============================================================================

$reportLog = @()
$reportLog += "====================================================================="
$reportLog += "              WEEKLY ENDPOINT MAINTENANCE REPORT                     "
$reportLog += "====================================================================="

# ---------------------------------------------------------
# Phase 1: Context & Security Checks
# ---------------------------------------------------------
$loggedInUser = (Get-WmiObject -Class Win32_ComputerSystem).UserName
$userIsLoggedOn = -not [string]::IsNullOrWhiteSpace($loggedInUser)

if ($userIsLoggedOn) {
    $reportLog += "CONTEXT:  User [$loggedInUser] is active. Disruptive tasks scheduled for 10:00 PM."
} else {
    $reportLog += "CONTEXT:  No user logged in. Authorized for immediate aggressive maintenance."
}

$s1 = Get-Service -Name "SentinelAgent" -ErrorAction SilentlyContinue
if ($s1 -and $s1.Status -eq 'Running') { 
    $reportLog += "SECURITY: [OK] SentinelOne is actively running." 
} else { 
    $reportLog += "SECURITY: [ALERT] SentinelOne is MISSING or STOPPED." 
}

# ---------------------------------------------------------
# Phase 2: OmniSync Deep Health & Escalation
# ---------------------------------------------------------
$omniServiceName = "OmniSync Service"
$omniGuiName = "agent_gui"

$omniService = Get-Service -Name $omniServiceName -ErrorAction SilentlyContinue
if ($null -eq $omniService) {
    $reportLog += "SYNC:     [INFO] OmniSync is not installed on this device."
} else {
    $omniGui = Get-Process -Name "*$omniGuiName*" -ErrorAction SilentlyContinue
    if ($omniService.Status -ne 'Running' -or ($userIsLoggedOn -and -not $omniGui)) {
        $reportLog += "SYNC:     [REMEDIATING] OmniSync crash detected. Executing Escalation Ladder..."
        Stop-Service -Name $omniServiceName -Force -ErrorAction SilentlyContinue
        Get-Process -Name "*$omniGuiName*" -ErrorAction SilentlyContinue | Stop-Process -Force
        
        # Deadlock Breaker
        $stuckService = Get-WmiObject Win32_Service -Filter "Name='$omniServiceName'"
        if ($stuckService -and $stuckService.ProcessId -ne 0) {
            Stop-Process -Id $stuckService.ProcessId -Force -ErrorAction SilentlyContinue
        }
        
        Start-Service -Name $omniServiceName -ErrorAction SilentlyContinue
        Start-Sleep -Seconds 5

        # Session Jump (GUI Injector)
        if ($userIsLoggedOn -and -not (Get-Process -Name "*$omniGuiName*" -ErrorAction SilentlyContinue)) {
            $guiPath = (Get-ChildItem -Path "C:\Program Files (x86)" -Filter "$omniGuiName.exe" -Recurse -ErrorAction SilentlyContinue | Select-Object -First 1).FullName
            if ($guiPath) {
                $action = New-ScheduledTaskAction -Execute $guiPath
                $trigger = New-ScheduledTaskTrigger -AtStartup 
                $principal = New-ScheduledTaskPrincipal -UserId $loggedInUser -LogonType Interactive
                Register-ScheduledTask -TaskName "OmniSyncGUI_Restarter" -Action $action -Principal $principal -Force | Out-Null
                Start-ScheduledTask -TaskName "OmniSyncGUI_Restarter"
                Start-Sleep -Seconds 4
                Unregister-ScheduledTask -TaskName "OmniSyncGUI_Restarter" -Confirm:$false | Out-Null
            }
        }
        $reportLog += "SYNC:     [REMEDIATED] OmniSync successfully restarted and injected to desktop."
    } else {
        $reportLog += "SYNC:     [OK] OmniSync is healthy and standing by."
    }
}

# ---------------------------------------------------------
# Phase 3: Hardware Audit (The 100% Disk Spike Check)
# ---------------------------------------------------------
$storageController = Get-WmiObject Win32_SCSIController | Where-Object { $_.DriverName -match "iaStor" }
if ($storageController) {
    $reportLog += "HARDWARE: [WARNING] Intel RST Controller detected ($($storageController.Name)). Potential risk for 100% Active Disk spikes."
} else {
    $reportLog += "HARDWARE: [OK] Standard AHCI/NVMe storage controller in use."
}

# ---------------------------------------------------------
# Phase 4: Performance Audit, Storage & VSS "Ghost Weight" Purge
# ---------------------------------------------------------
$cDrive = Get-Volume -DriveLetter C -ErrorAction SilentlyContinue
if ($cDrive) {
    $percentFree = [math]::Round(($cDrive.SizeRemaining / $cDrive.Size) * 100, 2)
    if ($percentFree -lt 15) {
        $reportLog += "STORAGE:  [REMEDIATED] C: Drive critically low ($percentFree% free). Initiating Deep Clean..."
        Remove-Item -Path "C:\Windows\Temp\*" -Recurse -Force -ErrorAction SilentlyContinue
        if ($userIsLoggedOn) {
            $userTemp = "C:\Users\$($loggedInUser.Split('\')[1])\AppData\Local\Temp\*"
            Remove-Item -Path $userTemp -Recurse -Force -ErrorAction SilentlyContinue
        }
        Clear-RecycleBin -Force -ErrorAction SilentlyContinue
        
        # Purge VSS Shadow Copies
        $initialVssCount = (vssadmin list shadows | Select-String "Shadow Copy ID").Count
        if ($initialVssCount -gt 0) {
            vssadmin delete shadows /all /quiet | Out-Null
            $reportLog += "STORAGE:  [REMEDIATED] Purged $initialVssCount hidden Volume Shadow Copies (VSS) to reclaim 'Ghost Weight'."
        }
    } else {
        $reportLog += "STORAGE:  [OK] C: Drive space is healthy ($percentFree% free)."
    }
}

# ---------------------------------------------------------
# Phase 5: Business Environment Optimization (Telemetry & Xbox Kill)
# ---------------------------------------------------------
$osInfo = Get-CimInstance Win32_OperatingSystem
if ($osInfo.OperatingSystemSKU -eq 48 -or $osInfo.Caption -match "Pro|Enterprise") {
    
    # Kill Telemetry via Registry
    $regPath = "HKLM:\SOFTWARE\Policies\Microsoft\Windows\DataCollection"
    if (!(Test-Path $regPath)) { New-Item -Path $regPath -Force | Out-Null }
    $telemetryVal = (Get-ItemProperty -Path $regPath -Name "AllowTelemetry" -ErrorAction SilentlyContinue).AllowTelemetry
    if ($telemetryVal -ne 0) {
        Set-ItemProperty -Path $regPath -Name "AllowTelemetry" -Value 0 -Type DWord -Force
        $reportLog += "SYSTEM:   [REMEDIATED] Windows Telemetry (DiagTrack) forcefully restricted via Registry."
    }

    # Disable heavy, unused consumer services
    $servicesToDisable = @("DiagTrack", "dmwappushservice", "XblAuthManager", "XblGameSave", "XboxNetApiSvc", "XboxGipSvc")
    $disabledCount = 0
    foreach ($svcName in $servicesToDisable) {
        $svc = Get-Service -Name $svcName -ErrorAction SilentlyContinue
        if ($svc -and $svc.StartType -ne 'Disabled') {
            Stop-Service -Name $svcName -Force -ErrorAction SilentlyContinue
            Set-Service -Name $svcName -StartupType Disabled -ErrorAction SilentlyContinue
            $disabledCount++
        }
    }
    if ($disabledCount -gt 0) {
        $reportLog += "SYSTEM:   [REMEDIATED] Disabled $disabledCount unused consumer services (Xbox/Telemetry)."
    }
}

# ---------------------------------------------------------
# Phase 6: Network Infrastructure Optimization
# ---------------------------------------------------------
Clear-DnsClientCache
$reportLog += "NETWORK:  [REMEDIATED] DNS Resolver Cache flushed."

$adapters = Get-NetAdapter -Physical -ErrorAction SilentlyContinue | Where-Object Status -eq 'Up'
foreach ($adapter in $adapters) {
    # Check/Disable IPv6
    $ipv6 = Get-NetAdapterBinding -InterfaceAlias $adapter.Name -ComponentID ms_tcpip6
    if ($ipv6.Enabled) {
        Disable-NetAdapterBinding -InterfaceAlias $adapter.Name -ComponentID ms_tcpip6
        $reportLog += "NETWORK:  [REMEDIATED] IPv6 disabled on '$($adapter.Name)'."
    }
    # Check/Ensure IPv4
    $ipv4 = Get-NetAdapterBinding -InterfaceAlias $adapter.Name -ComponentID ms_tcpip
    if (-not $ipv4.Enabled) {
        Enable-NetAdapterBinding -InterfaceAlias $adapter.Name -ComponentID ms_tcpip
        $reportLog += "NETWORK:  [REMEDIATED] IPv4 forcefully enabled on '$($adapter.Name)'."
    }
}

# LAN Power Management Fix
$nicRegPaths = Get-ChildItem "HKLM:\System\CurrentControlSet\Control\Class\{4D36E972-E325-11CE-BFC1-08002BE10318}" -ErrorAction SilentlyContinue | Where-Object { $_.PSChildName -match '^\d{4}$' }
foreach ($nic in $nicRegPaths) {
    $driverDesc = (Get-ItemProperty -Path $nic.PSPath -Name "DriverDesc" -ErrorAction SilentlyContinue).DriverDesc
    if ($driverDesc -and $driverDesc -notmatch "Virtual|VPN|Bluetooth|Hyper-V|WAN|TAP") {
        $pnpCap = Get-ItemProperty -Path $nic.PSPath -Name "PnPCapabilities" -ErrorAction SilentlyContinue
        if ($null -eq $pnpCap.PnPCapabilities -or ($pnpCap.PnPCapabilities -band 24) -ne 24) {
            Set-ItemProperty -Path $nic.PSPath -Name "PnPCapabilities" -Value 24 -ErrorAction SilentlyContinue
            $reportLog += "NETWORK:  [REMEDIATED] Disabled Power Save Mode on '$driverDesc'."
        }
    }
}

# ---------------------------------------------------------
# Phase 7: Stuck Installer Remediation
# ---------------------------------------------------------
$InstallerNames = @("msiexec", "setup", "install", "issetup", "dism", "TiWorker", "TrustedInstaller")
$killedInstallers = 0
foreach ($Name in $InstallerNames) {
    $Processes = Get-Process -Name $Name -ErrorAction SilentlyContinue
    if ($Processes) {
        foreach ($Process in $Processes) {
            try { Stop-Process -Id $Process.Id -Force -ErrorAction Stop; $killedInstallers++ } catch { }
        }
    }
}
if ($killedInstallers -gt 0) {
    $reportLog += "UPDATES:  [REMEDIATED] Force-killed $killedInstallers stuck installer process(es)."
}

# ---------------------------------------------------------
# Phase 8: OS Update Cache Remediation (Failed Patches)
# ---------------------------------------------------------
$cacheCleared = $false
try {
    $UpdateSession = New-Object -ComObject Microsoft.Update.Session
    $UpdateSearcher = $UpdateSession.CreateUpdateSearcher()
    $HistoryCount = $UpdateSearcher.GetTotalHistoryCount()
    
    if ($HistoryCount -gt 0) {
        $CheckCount = [math]::Min($HistoryCount, 15)
        $History = $UpdateSearcher.QueryHistory(0, $CheckCount)
        $FailedUpdates = $History | Where-Object { $_.ResultCode -eq 4 -or $_.ResultCode -eq 3 }
        
        if ($FailedUpdates) {
            $reportLog += "PATCHING: [ALERT] Detected $($FailedUpdates.Count) recently failed OS Updates."
            $reportLog += "PATCHING: [REMEDIATING] Force-rebuilding Windows Update components (SoftwareDistribution)..."
            
            Stop-Service -Name wuauserv, bits, cryptsvc, msiserver -Force -ErrorAction SilentlyContinue
            Start-Sleep -Seconds 3
            Remove-Item -Path "C:\Windows\SoftwareDistribution\*" -Recurse -Force -ErrorAction SilentlyContinue
            Remove-Item -Path "C:\Windows\System32\catroot2\*" -Recurse -Force -ErrorAction SilentlyContinue
            Start-Service -Name wuauserv, bits, cryptsvc, msiserver -ErrorAction SilentlyContinue
            
            $cacheCleared = $true
            $reportLog += "PATCHING: [REMEDIATED] Update cache purged. System is prepped for direct patching."
        } else {
            $reportLog += "PATCHING: [OK] No recent Windows Update installation failures detected."
        }
    }
} catch {
    $reportLog += "PATCHING: [WARNING] Unable to query Windows Update API. Skipping cache audit."
}

# ---------------------------------------------------------
# Phase 9: Autonomous Patching Execution (Winget + OS)
# ---------------------------------------------------------
$wingetArgs = "upgrade --all --silent --accept-package-agreements --accept-source-agreements"

if (-not $userIsLoggedOn) {
    # 1. Execute Third-Party App Updates Immediately
    try {
        $wingetPath = Resolve-Path "C:\Program Files\WindowsApps\Microsoft.DesktopAppInstaller_*_x64__8wekyb3d8bbwe\winget.exe" -ErrorAction SilentlyContinue | Select-Object -ExpandProperty Path -First 1
        if ($wingetPath) {
            $updateOut = & $wingetPath $wingetArgs | Out-String
            if ($updateOut -match "No installed packages have available upgrades" -or $updateOut -match "No available upgrades") {
                $reportLog += "APPS:     [OK] All third-party applications are already up to date."
            } else {
                $reportLog += "APPS:     [REMEDIATED] Winget successfully installed pending upgrades in the background."
            }
        }
    } catch {}

    # 2. Force Immediate OS Update Scan & Install (Bypassing RMM Sync)
    $reportLog += "PATCHING: [ACTION] Taking native control. Triggering OS Update Orchestrator (UsoClient.exe)..."
    try {
        Start-Process -FilePath "UsoClient.exe" -ArgumentList "ScanInstallWait" -NoNewWindow -Wait:$false
        $reportLog += "PATCHING: [OK] Windows Update successfully triggered in the background."
    } catch {
        $reportLog += "PATCHING: [ERROR] Failed to initiate native UsoClient."
    }

} else {
    $reportLog += "UPDATES:  [STANDBY] User is active. OS and App updates armed for 10:00 PM tonight."
    
    # Build the autonomous Nightly Payload
    $payloadPath = "C:\Windows\Temp\NightlyUpdatePayload.ps1"
    $payloadContent = @"
        # 1. Update 3rd Party Apps
        `$wingetPath = Resolve-Path "C:\Program Files\WindowsApps\Microsoft.DesktopAppInstaller_*_x64__8wekyb3d8bbwe\winget.exe" -ErrorAction SilentlyContinue | Select-Object -ExpandProperty Path -First 1
        if (`$wingetPath) { & `$wingetPath upgrade --all --silent --accept-package-agreements --accept-source-agreements }
        Start-Sleep -Seconds 30

        # 2. Trigger native Windows Update Orchestrator to scan, download, and install
        Start-Process -FilePath "UsoClient.exe" -ArgumentList "ScanInstallWait" -NoNewWindow -Wait:`$false
        
        # Note: No forced Restart-Computer command used here to avoid interrupting in-progress OS patches. 
        # The Update Orchestrator natively handles the reboot requirement outside Active Hours.
"@
    Set-Content -Path $payloadPath -Value $payloadContent -Force

    $action = New-ScheduledTaskAction -Execute "PowerShell.exe" -Argument "-ExecutionPolicy Bypass -WindowStyle Hidden -File $payloadPath"
    $trigger = New-ScheduledTaskTrigger -Once -At 10:00PM
    $principal = New-ScheduledTaskPrincipal -UserId "SYSTEM" -LogonType ServiceAccount -RunLevel Highest
    
    Register-ScheduledTask -TaskName "MSP_Nightly_Maintenance" -Action $action -Trigger $trigger -Principal $principal -Force | Out-Null
}

# ---------------------------------------------------------
# Final Output
# ---------------------------------------------------------
$reportLog += "====================================================================="
$reportLog | ForEach-Object { Write-Output $_ }
